DATABASE_URL=
REDIS_URL=
APP_ENCRYPTION_KEY=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
# Fresh verified scheduled roots and authorized full rebuilds use this planner.
# Immutable saved-story recovery and voice/video provider models are unchanged.
STUDIO_FRESH_PLAN_OPENAI_MODEL=gpt-6-astra
# Staged Abacus editorial refinement for fresh scheduled jobs only.
# Requires commissioned spend enforcement; keep disabled during rollout.
ABACUS_API_KEY=
STUDIO_ABACUS_EDITORIAL_ENABLED=false
STUDIO_ABACUS_EDITORIAL_MODEL=claude-haiku-4-5-20251001
# Optional visual-only reviewer: openai, gemini or abacus. Blank follows STUDIO_PLAN_PROVIDER.
# This does not change script generation, quality thresholds, or publication mode.
# Abacus requires ABACUS_API_KEY, enforced spending and an admitted vision-price
# funding route; model is fixed to claude-haiku-4-5-20251001. No automatic fallback.
STUDIO_VISUAL_QC_PROVIDER=
# Dedicated OpenAI picture reviewer; other OPENAI_MODEL workloads are unchanged.
STUDIO_VISUAL_QC_OPENAI_MODEL=gpt-6-astra
# Total accepted/reserved AI-video creates per new 30s production Short (2-6).
# Includes repairs; saved task caps stay frozen. Preview default remains 2.
STUDIO_PRODUCTION_SHORT_PAID_CREATE_CAP=2

# Staged USD control; do not enable until quotes and ledger are commissioned.
# All six policy values are integer micro-USD, NOT dollars or credits.
# Empty/missing policy is an error when enforcement is enabled.
STUDIO_SPEND_ENFORCEMENT=false
STUDIO_SPEND_POLICY_JSON=
STUDIO_ELEVENLABS_PRICING_EVIDENCE_JSON=

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

PEXELS_API_KEY=
RUNWAYML_API_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
YOUTUBE_DEFAULT_PRIVACY=private
