DATABASE_URL=
REDIS_URL=
APP_ENCRYPTION_KEY=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
# Fresh verified scheduled roots and authorized full rebuilds use this planner.
# Immutable saved-story recovery and voice/video provider models are unchanged.
STUDIO_FRESH_PLAN_OPENAI_MODEL=gpt-5
# Staged Abacus editorial refinement for fresh scheduled jobs only.
# Requires commissioned spend enforcement; keep disabled during rollout.
ABACUS_API_KEY=
STUDIO_ABACUS_EDITORIAL_ENABLED=false
STUDIO_ABACUS_EDITORIAL_MODEL=claude-haiku-4-5-20251001
# Existing-subscription RouteLLM research, independent QA and next-series planning.
# Explicit cash-disabled and native-credit commissioning is required first.
# Does not authorize paid image/video generation, credit purchases or fixed premium models.
STUDIO_ABACUS_INCLUDED_PRODUCTION=false
STUDIO_ABACUS_PREPAID_AUDIO=false
# Optional visual-only reviewer: openai, gemini or abacus. Blank follows STUDIO_PLAN_PROVIDER.
# This does not change script generation, quality thresholds, or publication mode.
# Abacus requires ABACUS_API_KEY, enforced spending and an admitted vision-price
# funding route; model is fixed to claude-haiku-4-5-20251001. No automatic fallback.
STUDIO_VISUAL_QC_PROVIDER=
# Dedicated OpenAI picture reviewer; other OPENAI_MODEL workloads are unchanged.
STUDIO_VISUAL_QC_OPENAI_MODEL=gpt-5
# Total accepted/reserved AI-video creates per new 30s production Short (2-6).
# Includes repairs; saved task caps stay frozen. Preview default remains 2.
STUDIO_PRODUCTION_SHORT_PAID_CREATE_CAP=2

# Staged USD control; do not enable until quotes and ledger are commissioned.
# All six policy values are integer micro-USD, NOT dollars or credits.
# Empty/missing policy is an error when enforcement is enabled.
STUDIO_SPEND_ENFORCEMENT=false
STUDIO_SPEND_POLICY_JSON=
STUDIO_ELEVENLABS_PRICING_EVIDENCE_JSON=

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

PEXELS_API_KEY=
RUNWAYML_API_SECRET=
FAL_KEY=
# Enable after installing the matching code and configuring existing spending.
# fal uses silent 720p Veo Lite up to 8s, Seedance 1.5 Pro for longer shots.
STUDIO_VIDEO_PROVIDER=fal
STUDIO_FAL_VIDEO_MODEL=auto

# New system: its own test channel, spend limits and Redis ownership.
# Use a separate Redis; the first start claims it for STUDIO_DEPLOYMENT_ID.
STUDIO_DEPLOYMENT_ID=new-system
STUDIO_CAPITAL_CHANNEL_ID=
STUDIO_MARGIN_CHANNEL_ID=
# Daily metered AI spend cap (USD, Turkey day), room a new video needs under
# it, and the most one Short's script stage may spend.
COST_DAILY_CAP_USD=8
COST_SHORT_ADMISSION_RESERVE_USD=1.5
COST_PLANNING_TASK_CAP_USD=1.5
# Only Shorts on the main channel while STUDIO_SHORTS_POLICY_JSON is empty.
STUDIO_DEFAULT_SHORTS_PER_DAY=5

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
YOUTUBE_DEFAULT_PRIVACY=private
